# BitMagnet 配置示例 —— 复制为 .env 后按需修改
# cp .env.example .env

# PostgreSQL 密码（postgres 容器与 bitmagnet 容器必须一致）
# 若复用已有的历史数据目录，请保持与当时一致（原部署为 bitmagnet）
POSTGRES_PASSWORD=bitmagnet

# Web UI / API / Torznab 对外映射端口（容器内固定 3333）
WEB_PORT=3333

# 数据根目录：postgres 数据、bitmagnet 配置都落在此目录下
# 生产建议指向大盘，例如 /vol1/bitmagnet
DATA_DIR=./data

# TMDB 元数据 enrichment 开关（默认 false：无需外网 TMDB，开箱即索引）
# 若填写了 TMDB_API_KEY，请将此项改为 true
TMDB_ENABLED=false

# 可选：TMDB API Key，开启影视元数据 enrichment（海报/年份/类型）
# TMDB_API_KEY=

# 可选：TMDB 出网代理（面板保存后自动重建 bitmagnet 以生效）
# TMDB_PROXY=

# ===== 管理面板 bitmagnet-bot（Web 端口 8790）=====
# 面板提供：搜索 / 一键发 qBittorrent、系统状态汇总、TMDB 配置、Clash 出网自愈（可选）。
# 仅 BITMAGNET_HOST / PORT 为面板自身所需，已在 compose 内固定；
# 以下为可选增强，留空即不启用对应能力。

# 管理面板对外映射端口（容器内固定 8790）
BOT_PORT=8790

# 可选：qBittorrent 一键下载（留空则面板不显示下载入口）
# QBITTORRENT_URL=http://qbittorrent:8080
# QBITTORRENT_USER=admin
# QBITTORRENT_PASS=adminadmin
# QBITTORRENT_CATEGORY=bitmagnet

# 可选：Clash / OpenClash 出网自愈（环境专属，按需开启；不填则面板内出网自愈按钮不可用）
# CLASH_API_URL=http://<clash-host>:9090
# CLASH_API_TOKEN=
# CLASH_PROXY=
