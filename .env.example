# BitMagnet 配置示例 —— 复制为 .env 后按需修改
# cp .env.example .env

# PostgreSQL 密码（postgres 容器与 bitmagnet 容器必须一致）
# 若复用已有的历史数据目录，请保持与当时一致（原部署为 bitmagnet）
POSTGRES_PASSWORD=bitmagnet

# Web UI / API / Torznab 对外映射端口（容器内固定 3333）
WEB_PORT=3333

# 数据根目录：postgres 数据、bitmagnet 配置都落在此目录下
# 生产建议指向大盘，例如 /vol1/bitmagnet
DATA_DIR=./data

# TMDB 元数据 enrichment 开关（默认 false：无需外网 TMDB，开箱即索引）
# 若填写了 TMDB_API_KEY，请将此项改为 true
TMDB_ENABLED=false

# 可选：TMDB API Key，开启影视元数据 enrichment（海报/年份/类型）
# TMDB_API_KEY=
